        "client": [
            "com.boundingelf10.fec.FlashbackEssentialsCompatibilityClient"
        ]
	},
	"mixins": [
		"flashback-essentials-compatibility.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": ">=1.21 <=1.21.11",
		"java": ">=21",
