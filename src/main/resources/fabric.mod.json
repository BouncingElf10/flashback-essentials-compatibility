	"authors": [
		"BouncingElf10"
	],
	"contact": {
		"sources": "https://github.com/BouncingElf10/flashback-essentials-compatibility",
        "issues": "https://github.com/BouncingElf10/flashback-essentials-compatibility/issues"
	},
	"license": "GPL-3.0",
	"icon": "assets/flashback-essentials-compatibility/icon.png",
